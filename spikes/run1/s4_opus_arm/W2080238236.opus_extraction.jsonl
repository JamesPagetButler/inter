{"subject": "eigenfunctions of the Laplacian for transverse-traceless totally-symmetric tensor fields and p-forms on S^N and H^N", "relation": "proves", "object": "explicit eigenfunctions on S^N and H^N", "modality": "cited", "locator": "Introduction"}
{"subject": "Dirac equation", "relation": "defines", "object": "\\not\\nabla\\psi = i\\lambda\\psi", "modality": "stated", "locator": "Eq. (3.14)"}
{"subject": "Dirac equation on S^N", "relation": "uses-technique", "object": "separation into radial equations for phi_pm in the metric ds_N^2 = d\\theta^2 + f^2(\\theta) ds_{N-1}^2", "modality": "stated", "locator": "Eq. (3.17)-(3.18)"}
{"subject": "Dirac equation on S^N", "relation": "proves", "object": "\\not\\nabla^2\\psi = -\\lambda^2\\psi", "modality": "stated", "locator": "Eq. (3.18)"}
{"subject": "harmonics chi^{(pm)}_{lm}", "relation": "defines", "object": "\\tilde{\\not\\nabla}\\chi^{(\\pm)}_{lm} = \\pm i(l+\\rho)\\chi^{(\\pm)}_{lm}", "modality": "stated", "locator": "Eq. (3.19)"}
{"subject": "radial functions phi_nl(theta) on S^N", "relation": "uses-technique", "object": "hypergeometric/Jacobi-polynomial ODE D\\phi_{nl} = -\\lambda^2_{n,N}\\phi_{nl}", "modality": "stated", "locator": "Eq. (3.22)-(3.28)"}
{"subject": "radial functions phi_nl(theta) on S^N", "relation": "proves", "object": "\\phi_{nl}(\\theta) = (\\cos\\frac{\\theta}{2})^{l+1}(\\sin\\frac{\\theta}{2})^{l} P_{n-l}^{(N/2+l-1, N/2+l)}(\\cos\\theta)", "modality": "stated", "locator": "Eq. (3.28)"}
{"subject": "Dirac eigenvalues on S^N", "relation": "proves", "object": "\\lambda_{n,N}^2 = (n+N/2)^2", "modality": "stated", "locator": "Eq. (3.28)"}
{"subject": "partner function psi_nl(theta)", "relation": "proves", "object": "\\psi_{nl}(\\theta) = (-1)^{n-l}\\phi_{nl}(\\pi-\\theta)", "modality": "stated", "locator": "Eq. (3.29)-(3.32)"}
{"subject": "pair (phi_nl, psi_nl)", "relation": "proves", "object": "coupled first-order recursion in n", "modality": "stated", "locator": "Eq. (3.29)-(3.32)"}
{"subject": "eigenspinors psi^{(s)}_{pm nlm} on S^N", "relation": "proves", "object": "\\not\\nabla\\psi^{(s)}_{\\pm nlm} = \\pm i(n+N/2)\\psi^{(s)}_{\\pm nlm}", "modality": "stated", "locator": "Eq. (3.40)"}
{"subject": "eigenspinors psi^{(s)}_{pm nlm}", "relation": "proves", "object": "orthonormality on S^N", "modality": "stated", "locator": "Eq. (3.41)"}
{"subject": "eigenspinors psi^{(s)}_{pm nlm}", "relation": "proves", "object": "orthonormality on S^{N-1}", "modality": "stated", "locator": "Eq. (3.42)"}
{"subject": "normalization constant c_N(nl)", "relation": "proves", "object": "|c_N(nl)|^{-2} = 2^{N-2}|\\Gamma(N/2+n)|^2 / ((n-l)!(N+n+l-1)!)", "modality": "stated", "locator": "Eq. (3.44)"}
{"subject": "degeneracy D_N(n) of eigenvalue n on S^N", "relation": "proves", "object": "D_N(n) = 2^{N/2}(N+n-1)! / (n!(N-1)!)", "modality": "stated", "locator": "Eq. (3.54)"}
{"subject": "degeneracy D_N(n) under alternative normalization", "relation": "proves", "object": "D_N(n) = 2^{(N-1)/2}(N+n-1)! / (n!(N-1)!)", "modality": "stated", "locator": "Eq. (3.68)"}
{"subject": "Dirac eigenspinors on H^N", "relation": "uses-technique", "object": "analytic continuation from S^N via theta -> iy, n -> -i\\lambda - N/2", "modality": "stated", "locator": "Eq. (3.69)"}
{"subject": "radial functions phi_{lambda l}(y), psi_{lambda l}(y) on H^N", "relation": "proves", "object": "expressions in terms of hypergeometric functions", "modality": "stated", "locator": "Eq. (3.70)-(3.71)"}
{"subject": "asymptotic coefficient c_l(lambda) on H^N", "relation": "proves", "object": "c_l(\\lambda) = (2^{N-2}/\\sqrt\\pi) \\Gamma(N/2+l)\\Gamma(1/2+i\\lambda) / \\Gamma(N/2+l+i\\lambda)", "modality": "stated", "locator": "Eq. (3.76)"}
{"subject": "spectral measure mu(lambda) on H^N", "relation": "proves", "object": "\\mu(\\lambda) = (\\pi/2^{2N-4}) |\\Gamma(N/2+i\\lambda) / (\\Gamma(N/2)\\Gamma(1/2+i\\lambda))|^2", "modality": "stated", "locator": "Eq. (3.79)"}
{"subject": "spectral measure mu(lambda) on H^N", "relation": "proves", "object": "closed product form distinguishing N odd and N even", "modality": "stated", "locator": "Eq. (3.80)"}
{"subject": "heat kernel K(x,x',t) on S^N", "relation": "defines", "object": "(-\\partial_t + \\not\\nabla_x^2)K = 0 with \\lim_{t\\to0}\\int_{S^N}K(x,x',t)\\psi(x')dx' = \\psi(x)", "modality": "stated", "locator": "Eq. (4.1)-(4.2)"}
{"subject": "heat kernel on S^N", "relation": "proves", "object": "mode sum K = \\sum_{n,l,m}[\\psi^{(-)}_{nlm}\\otimes\\psi^{(-)*}_{nlm} + \\psi^{(+)}_{nlm}\\otimes\\psi^{(+)*}_{nlm}] e^{-t(n+N/2)^2}", "modality": "stated", "locator": "Eq. (4.4)-(4.5)"}
{"subject": "heat kernel on S^N", "relation": "uses-technique", "object": "addition theorem \\sum_m \\hat\\chi^{(\\pm)}_{lm}\\otimes\\hat\\chi^{(\\pm)*}_{lm} = D_{N-1}(l)/(D_{N-1}(0)\\Omega_{N-1}) \\mathbf{1}", "modality": "stated", "locator": "Eq. (4.6)"}
{"subject": "heat kernel on S^N", "relation": "proves", "object": "scalar function of geodesic distance times the identity, K = \\mathbf{1}\\sum_{n,l} D_{N-1}(l)|c_N(nl)|^2/(D_{N-1}(0)\\Omega_{N-1}) [\\phi_{nl}\\phi'_{nl} + \\psi_{nl}\\psi'_{nl}] e^{-t(n+N/2)^2}", "modality": "stated", "locator": "Eq. (4.7)"}
{"subject": "heat kernel on S^N", "relation": "proves", "object": "K(x,x',t) = U(x,x') f_N(d(x,x'),t) with f_N(\\theta,t) = (1/\\Omega_N)\\sum_n d_n\\phi_n(\\theta)e^{-t(n+N/2)^2}, d_n = 2(n+N-1)!/(n!(N-1)!)", "modality": "stated", "locator": "Eq. (4.12)-(4.15)"}
{"subject": "U(x,x')", "relation": "defines", "object": "spinor parallel transport (parallel propagator)", "modality": "stated", "locator": "Eq. (4.12)-(4.15)"}
{"subject": "heat kernel on H^N", "relation": "proves", "object": "K = U(x,x')\\hat f_N(d(x,x'),t) with \\hat f_N(y,t) = (2^{N-3}\\Gamma(N/2)/\\pi^{N/2+1})\\int_0^\\infty \\phi_\\lambda(y)e^{-t\\lambda^2}\\mu(\\lambda)d\\lambda", "modality": "stated", "locator": "Eq. (4.24)-(4.26)"}
{"subject": "heat kernel on H^N", "relation": "depends-on", "object": "spectral measure mu(lambda)", "modality": "stated", "locator": "Eq. (4.26)"}
{"subject": "Casimir eigenvalue omega_lambda", "relation": "proves", "object": "-\\omega_\\lambda = C_2(\\tau) - C_2(\\lambda)", "modality": "stated", "locator": "Eq. (5.6)"}
{"subject": "heat kernel on a general symmetric space U/K", "relation": "proves", "object": "K(x,y,t)^a_b = (1/d_\\tau)\\sum_{\\lambda,\\xi,I} d_\\lambda U^\\lambda(\\sigma^{-1}(x))^{a\\xi}_I \\overline{U^\\lambda(\\sigma^{-1}(y))^{b\\xi}_I} e^{-t\\omega_\\lambda}", "modality": "stated", "locator": "Eq. (5.9)"}
{"subject": "heat kernel on a general symmetric space U/K", "relation": "proves", "object": "K(x,y,t) = (1/d_\\tau)\\sum_{\\lambda\\in\\hat U(\\tau)} d_\\lambda \\varphi_\\lambda(x,y) e^{-t\\omega_\\lambda}", "modality": "stated", "locator": "Eq. (5.16)"}
{"subject": "heat kernel on a general symmetric space U/K", "relation": "depends-on", "object": "zonal spherical function \\varphi_\\lambda", "modality": "stated", "locator": "Eq. (5.16)"}
