{"subject":"D_N(n) (degeneracy, second form)","relation":"proves","object":"D_N(n) = 2^{(N-1)/2}(N+n-1)!/(n!(N-1)!)","modality":"stated","locator":"Eq. (3.68)"}
{"subject":"analytic continuation theta -> iy, n -> -i lambda - N/2","relation":"uses-technique","object":"hyperbolic eigenfunctions phi_{lambda l}(y), psi_{lambda l}(y) on H^N","modality":"stated","locator":"Eq. (3.69)"}
