{"subject":"heat kernel K on S^N","relation":"proves","object":"spectral sum K = sum |c_N|^2 [phi phi chi chi + psi psi chi chi] e^{-t(n+N/2)^2}","modality":"stated","locator":"Eq. (4.5)"}
{"subject":"heat kernel K(x,x',t) on S^N","relation":"proves","object":"K(x,x',t) = U(x,x') f_N(d(x,x'),t)","modality":"stated","locator":"Eq. (4.15)"}
