# git-backup@<seat>.env — copy to ~/.config/git-backup/<seat>.env and edit.
#
# Used by resource/git-backup@.service (systemd --user template unit).
# One file per (repo, seat) you want on a backup cadence.

# Absolute path to the repo working tree this timer instance backs up.
GIT_BACKUP_REPO=/home/prime/Documents/<repo>

# Absolute path to the git-backup script itself (usually the copy in the
# inter repo, shared across all seats/repos).
GIT_BACKUP_BIN=/home/prime/Documents/inter/resource/git-backup

# Remote to push refs/backup/<seat>/<branch> to. Defaults to origin if unset.
GIT_BACKUP_REMOTE=origin
